{
  "annotations": { "list": [] },
  "description": "Business funnel metrics. D1/D7 retention gauges are written once per UTC day by the in-process retention job (RETENTION_JOB_ENABLED=true, docker-compose.staging.yml); they read 'No data' until the job's first run.",
  "editable": false,
  "panels": [
    {
      "title": "Signups (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(increase(business_signup_total[24h]))",
        "legendFormat": "signups"
      }]
    },
    {
      "title": "Transactions (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(increase(business_transaction_total[24h]))",
        "legendFormat": "txns"
      }]
    },
    {
      "title": "Exports (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(increase(business_export_total[24h]))",
        "legendFormat": "exports"
      }]
    },
    {
      "title": "D1 Retention (%)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "max(business_d1_retention_rate)",
        "instant": true,
        "legendFormat": "D1 %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } }
    },
    {
      "title": "Funnel (7d cohort)",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(business_signup_total[7d]))", "legendFormat": "signup" },
        { "expr": "sum(increase(business_transaction_total[7d])) > 0", "legendFormat": "transacted" },
        { "expr": "max(business_d1_retained_count)", "legendFormat": "D1 retained (latest day)" },
        { "expr": "max(business_d7_retained_count)", "legendFormat": "D7 retained (latest day)" },
        { "expr": "sum(increase(business_export_total[7d]))", "legendFormat": "exported" }
      ]
    },
    {
      "title": "Signup Rate Trend (daily)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(increase(business_signup_total[24h]))",
        "legendFormat": "signups/day"
      }]
    },
    {
      "title": "D7 Retention (%)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "max(business_d7_retention_rate)",
        "instant": true,
        "legendFormat": "D7 %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } }
    },
    {
      "title": "D1 / D7 Retention Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "max(business_d1_retention_rate)", "legendFormat": "D1 %" },
        { "expr": "max(business_d7_retention_rate)", "legendFormat": "D7 %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["aozora", "business"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "title": "Business Funnel",
  "uid": "aozora-business",
  "version": 1
}

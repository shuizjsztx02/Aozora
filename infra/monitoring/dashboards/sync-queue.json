{
  "annotations": { "list": [] },
  "description": "Sync queue health. Metrics emitted by server/src/common/telemetry.py (sync_push_total / sync_conflict_total / sync_queue_depth) — panels populate once the instrumentation in T-M5-05b is deployed.",
  "editable": false,
  "panels": [
    {
      "title": "Push Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(sync_push_total[5m]))",
        "legendFormat": "push/s"
      }]
    },
    {
      "title": "Conflict Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "100 * sum(rate(sync_conflict_total[5m])) / (sum(rate(sync_push_total[5m])) > 0)",
        "legendFormat": "conflict %"
      }]
    },
    {
      "title": "Queue Depth (pending mutations)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(sync_queue_depth)",
        "legendFormat": "pending"
      }]
    },
    {
      "title": "Sync Errors by Type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(sync_push_total{status=~\"5..\"}[5m])) by (error_class)",
        "legendFormat": "{{error_class}}"
      }]
    },
    {
      "title": "Sync Latency p95 (ms)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(sync_push_duration_ms_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["aozora", "sync"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Sync Queue",
  "uid": "aozora-sync",
  "version": 1
}

{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(api_requests_total[5m])) by (method)",
        "legendFormat": "{{method}}"
      }]
    },
    {
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "100 * sum(rate(api_errors_total[5m])) / (sum(rate(api_requests_total[5m])) > 0)",
        "legendFormat": "error %"
      }]
    },
    {
      "title": "Latency p50 / p95 / p99 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(api_request_duration_ms_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(api_request_duration_ms_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(api_request_duration_ms_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "title": "Availability (5m)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "100 * (1 - sum(rate(api_errors_total[5m])) / (sum(rate(api_requests_total[5m])) > 0))",
        "legendFormat": "availability %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "steps": [
        { "color": "red", "value": null },
        { "color": "yellow", "value": 99 },
        { "color": "green", "value": 99.9 }
      ]}}}
    },
    {
      "title": "Errors by Path (top 5)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "uid": "prometheus" },
      "targets": [{
        "expr": "topk(5, sum(increase(api_errors_total[1h])) by (path))",
        "format": "table",
        "instant": true
      }]
    }
  ],
  "schemaVersion": 39,
  "tags": ["aozora", "api", "slo"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "API SLO",
  "uid": "aozora-api-slo",
  "version": 1
}

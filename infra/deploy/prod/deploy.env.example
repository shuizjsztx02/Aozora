# deploy.env.example — 服务器 A 仓库根目录 `.env` 的模板
#
#   用法：cp infra/deploy/prod/deploy.env.example .env && vi .env
#   `.env` 已在 .gitignore 中，真实密钥不进仓库（docs/runbooks/secret-management.md）。
#   值由 docker-compose.prod.yml 在部署时注入容器，不进入镜像层。
#
# 本模板只含占位符；每行注释说明去哪儿取值。

# ─────────────── 数据库（服务器 B，内网） ───────────────
# 由 B 机执行 infra/deploy/prod/b-setup-postgres.sh 后，脚本末尾会打印
# 现成的这两行（含随机生成的业务账号密码），原样粘贴过来：
TEST_DATABASE_URL=postgresql+asyncpg://aozora_test:<PW>@192.168.44.12:15432/aozora_test
PROD_DATABASE_URL=postgresql+asyncpg://aozora_prod:<PW>@192.168.44.12:5432/aozora_prod

# ─────────────── JWT 签名密钥 ───────────────
# 各生成一个强随机值（两实例必须不同；测试与生产隔离）：
#   openssl rand -hex 32
TEST_SECRET_KEY=<openssl-rand-hex-32>
PROD_SECRET_KEY=<openssl-rand-hex-32>

# ─────────────── AI 网关（DashScope，两实例共用） ───────────────
# 本地 server/.env 里已有同一个 key，原样复制过来即可。
# 注意：ENV=production 下缺失该值 API 会拒绝启动；测试实例（staging）可留空降级。
AI_PROVIDER_API_KEY=<sk-...>
# AI_PROVIDER_MODEL=qwen3.7-flash
# AI_PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ─────────────── 游客 AI 日配额 ───────────────
# 测试实例默认 100000（连测方便）；生产默认 20（产品决策，勿随手调大）。
# TEST_AI_QUOTA=100000
# PROD_AI_QUOTA=20

# ─────────────── 生产 CORS（上生产前必填） ───────────────
# 必须为逗号分隔的 https://[子域.]aozora.app 列表（config.py 有格式校验器，
# 且拒绝 * / http）。域名备案 + 解析落地前，生产实例保持不启动。
# PROD_CORS_ORIGINS=https://api.aozora.app

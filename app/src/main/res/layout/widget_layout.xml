<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件布局 — 今日支出 + 预算进度 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- 无数据状态 -->
    <LinearLayout
        android:id="@+id/widget_no_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_empty_text"
            android:textColor="#888888"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 正常内容 -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 今日支出 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日支出"
            android:textColor="#888888"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_today_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥0.00"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_today_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 笔"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <!-- 预算进度行 -->
        <LinearLayout
            android:id="@+id/widget_budget_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="本月预算"
                android:textColor="#888888"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_budget_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 待同步提示 -->
    <TextView
        android:id="@+id/widget_sync_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="待同步"
        android:textColor="#AAAAAA"
        android:textSize="10sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  T-M5-02a (O-T-M5-02-1): data extraction rules for Android 12+ (API 31+).
  Mirrors android:allowBackup="false" — excludes every storage domain from
  both cloud backup and device-to-device transfer so the Play Console
  data-safety review can see an explicit deny-all policy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

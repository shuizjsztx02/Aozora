<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- FIX-002 / BUG-014: 触感反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- T-M4-05a: 通知权限（Android 13+）+ 启动恢复 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- T-M4-05a: 精确提醒（Android 12+ 需用户授予「闹钟和提醒」；未授予时代码降级 setWindow 不崩溃） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- T-M5-01d: Signature-level permission guarding the debug-only BridgeReceiver.
         Only apps signed with the same key (i.e. our own debug builds / adb shell)
         can send BRIDGE_COMMAND broadcasts. Third-party apps on the same device
         cannot. P1-4 hardening. -->
    <permission
        android:name="com.aozora.app.permission.BRIDGE_COMMAND"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.aozora.app.permission.BRIDGE_COMMAND" />

    <!-- T-M4-04a: 图片/相机权限（离线语音已随 REQ-75 移除，App 不再申请麦克风） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".AozoraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:dataExtractionRules="@xml/backup_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Aozora">
        <!-- T9-8（REQ-16）：adjustResize 在 35+ 下由 edge-to-edge 接管、实际靠 IME inset 注入；
             声明以统一低版本 WebView 行为 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- T-M4-05c: 深链路由 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aozora" />
            </intent-filter>
            <!-- T-M4-05c: 静态快捷方式 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- T-M4-05a: 提醒广播 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- T-M4-05a: 启动恢复 -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 第十一轮 T11-4: 定时记账每日闹钟回调（REQ-26/决策 #4） -->
        <receiver
            android:name=".scheduled.ScheduledTxReceiver"
            android:exported="false" />

        <!-- T-M4-05b: 桌面小组件 -->
        <receiver
            android:name=".widget.AozoraWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.aozora.app.widget.UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 第二十一轮 REQ-83（T21-3）：自动记账 · 通知通道。
             授权在系统的「通知使用权」页 —— BIND_NOTIFICATION_LISTENER_SERVICE 是
             系统持有的 signature 级权限，故本通道 **不新增任何 <uses-permission>**
             （决策 #3，由 SecurityConfigTest 的反向断言钉住）。
             无障碍通道的 <service> 由 T21-4 追加（同文件两卡严格串行）。 -->
        <service
            android:name=".autobook.AutoBookNotificationListener"
            android:exported="true"
            android:label="@string/autobook_notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- T-M4-04d: FileProvider for camera capture (content:// URI for temp image) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

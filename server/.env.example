# Aozora Server — Environment Configuration
# Copy to .env and fill in required values.

# Environment: development | staging | production
ENV=development

# PostgreSQL async connection string (REQUIRED)
DATABASE_URL=postgresql+asyncpg://aozora:aozora@localhost:5432/aozora

# Secret key for token signing (REQUIRED in production)
SECRET_KEY=dev-secret-do-not-use-in-production

# Redis URL (optional for first release)
# REDIS_URL=redis://localhost:6379/0

# API route prefix
API_PREFIX=/api/v1

# CORS allowed origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- AI Gateway (T-M4-01) ---
# Provider key comes ONLY from deployment secret storage (D-EXEC-04).
# Empty/unset → gateway degrades to 503 at runtime; startup is not blocked.
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_MODEL=qwen3.7-flash
# qwen 走 DashScope OpenAI 兼容模式（本地开发：向 key 提供方索取后直接填入 AI_PROVIDER_API_KEY）
# AI_PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Per-attempt timeout; 2 × timeout + overhead must stay < 25 s (client cancel line)
# AI_TIMEOUT_SECONDS=10
# Per-user burst limit (all users)
# AI_RATE_LIMIT_PER_MINUTE=10
# Daily quota for GUEST users only (ACTIVE users uncapped); resets at local midnight
# AI_DAILY_QUOTA_GUEST=20
# Cost accounting: price per 1M tokens in micro-CNY; 0 = not priced yet
# AI_PRICE_PER_1M_TOKENS=0

# --- AI Agent 路径 Provider（M7 / T-M7-02b，ADR-007）---
# agent 路径（多步 loop）走 DeepSeek；上方 AI_PROVIDER_* 仍服务快路径（DashScope），两者并存。
# 留空 → agent 路径不可用（灰度开关默认关闭），快路径与旧客户端行为不变。
# AI_AGENT_PROVIDER_API_KEY=
# AI_AGENT_PROVIDER_MODEL=deepseek-flash
# AI_AGENT_PROVIDER_BASE_URL=https://api.deepseek.com

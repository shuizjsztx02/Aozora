{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aozora.app/contracts/action-proposal/v1.json",
  "title": "ActionProposal",
  "description": "Aozora 动作提案契约 v1。消费者必须启用 format: date 的完整公历日期断言（含闰年），不得忽略 format。与 TypeScript 确定性校验器同输入同结论。",
  "type": "object",
  "required": ["proposalId", "action", "confidence", "requiresConfirmation", "message", "warnings"],
  "properties": {
    "proposalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "提案唯一标识"
    },
    "action": {
      "type": "string",
      "enum": ["add_tx", "add_tx_batch", "query", "report", "create_category", "config", "chat"],
      "description": "动作类型"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "置信度 [0, 1]"
    },
    "requiresConfirmation": {
      "type": "boolean",
      "description": "是否需要用户确认"
    },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/TransactionItem" },
      "description": "交易列表（add_tx/add_tx_batch 必填，见 allOf）"
    },
    "message": {
      "type": "string",
      "description": "面向用户的自然语言回复"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "警告列表"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "action": { "enum": ["add_tx", "add_tx_batch"] } },
        "required": ["action"]
      },
      "then": {
        "required": ["transactions"]
      }
    }
  ],
  "definitions": {
    "TransactionItem": {
      "type": "object",
      "required": ["type", "amountCents", "bizDate", "note"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["expense", "income"]
        },
        "amountCents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "正整数分金额"
        },
        "categoryId": {
          "type": "string",
          "minLength": 1
        },
        "categoryPath": {
          "type": "array",
          "items": { "type": "string" }
        },
        "accountId": {
          "type": "string",
          "minLength": 1
        },
        "bizDate": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "用户时区业务日期 YYYY-MM-DD；消费者必须断言 format: date"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
